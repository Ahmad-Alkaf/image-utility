# Copy to .env for local development. In Coolify, set these in the
# application's environment variables instead. Mark every NEXT_PUBLIC_*
# variable "Available at build time": they are inlined into the browser
# bundle when the image is built.

# Database (Prisma). The container runs `prisma migrate deploy` on start.
DATABASE_URL="postgresql://user:password@localhost:5432/imageforge?schema=public"

# Public site URL. Used for canonical links, Open Graph, sitemap, robots.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Webhook endpoint: POST /api/webhooks/clerk (events user.created, user.updated, user.deleted)
CLERK_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# File storage. Uploads and results are deleted after 24 hours.
# Leave the S3 keys empty to store files on disk in STORAGE_DIR
# (default ".storage"; the Docker image uses /app/.storage, mount a volume there).
# Set all five S3 keys to use S3 or Cloudflare R2 instead.
STORAGE_DIR=.storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional. Bearer token that lets an external scheduler call
# POST /api/cron/cleanup. The server already runs the cleanup hourly on
# its own; leave empty to disable the route.
CRON_SECRET=
